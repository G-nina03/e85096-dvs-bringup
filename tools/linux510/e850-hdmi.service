# HDMI out on the E850-96: DPU (DECON -> DSIM0) + LT8912B bridge; text console (tty1) on it.
# fb-hold.py keeps /dev/fb0 open: closing the last fd turns DECON/DSIM (and the panel power) off.
[Unit]
Description=E850-96 HDMI output (DPU + LT8912B)
After=systemd-modules-load.service

[Service]
Type=simple
ExecStartPre=/sbin/modprobe dpu
ExecStart=/usr/local/bin/fb-hold.py
# the bridge needs the DSI clock running, which starts when fb-hold.py unblanks
ExecStartPost=/bin/sh -c 'sleep 2; /usr/local/sbin/lt8912b-hdmi.sh'
# colours: the fb reports MONO01 and DECON drops palette writes at boot (modules/e850-fbpal);
# rebinding fbcon afterwards makes it pick colour mode
ExecStartPost=/bin/sh -c '/sbin/modprobe -r e850-fbpal; /sbin/modprobe e850-fbpal; echo 0 > /sys/class/vtconsole/vtcon1/bind; echo 1 > /sys/class/vtconsole/vtcon1/bind'
Restart=no

[Install]
WantedBy=multi-user.target
