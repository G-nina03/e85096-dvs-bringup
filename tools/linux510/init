#!/bin/busybox sh
# First-stage init for the E850-96 vendor 5.10 (GKI) kernel without Android.
#
# Most SoC drivers (timer, pinctrl, clocks, eMMC, UART) are modules, so this
# initramfs plays the role of Android's vendor_boot: load every module in
# modules.load order, then switch to the root filesystem given by root=.
#
# Stage 1 loads only what the eMMC, reboot, the watchdog and the USB device
# port need (modules.stage1). Then a USB gadget (ACM serial + ECM network)
# is set up on the USB-C port and e850-vbus.ko reports VBUS (this board has
# no PDIC chip that would); on the Mac the shell is /dev/cu.usbmodem*.
# The debug UART (ttySAC0) carries kernel messages only: opening it from user
# space hung the board (see docs/E85096-LINUX510-BOOT.md 7.15).
#
# After the gadget is up, init waits 10 s on the ACM port: press Enter for a
# rescue shell before the remaining modules are loaded. The shell has
# `restore-android` (writes the stock Android 10 boot image back) and
# `rebootarg bootloader` (next boot stops in LK fastboot).
# If no root is given or it cannot be mounted, a shell runs on the ACM port.
# This script never exits: PID 1 exiting panics the kernel.

/bin/busybox --install -s /bin
mkdir -p /proc /sys /dev /tmp /newroot
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /tmp
if ! mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
    # Kernel without CONFIG_DEVTMPFS: static nodes now, mdev after the modules
    mount -t tmpfs -o mode=0755 tmpfs /dev
    mknod -m 600 /dev/console c 5 1
    mknod -m 666 /dev/null c 1 3
    mknod -m 644 /dev/kmsg c 1 11
    echo /bin/mdev > /proc/sys/kernel/hotplug
    MDEV=1
fi
# Never open /dev/console here: it is the debug UART once exynos_tty is loaded.
exec </dev/null >/dev/null 2>&1

log() { echo "[init] $*" > /dev/kmsg; }

KVER=$(uname -r)
MODDIR=/lib/modules/$KVER
GS=/dev/ttyGS0

load_list() {
    n=0; fail=0
    for m in $(cat "$1"); do
        name=$(basename "$m" .ko)
        if modprobe "$name" 2>/tmp/err; then
            n=$((n + 1))
        else
            fail=$((fail + 1))
            log "modprobe $name failed: $(cat /tmp/err)"
        fi
    done
    [ -n "$MDEV" ] && mdev -s
    log "$1: $n ok, $fail failed"
}

# USB gadget through configfs: acm.usb0 -> /dev/ttyGS0, ecm.usb0 -> network interface usb0
# (ECM, not NCM: with NCM the Mac's transmit side failed - Oerrs 50, board RX 0; docs 7.18)
usb_gadget() {
    mkdir -p /sys/kernel/config
    mount -t configfs configfs /sys/kernel/config 2>/dev/null
    i=0
    while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
    udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
    if [ -z "$udc" ]; then
        log "no USB device controller (/sys/class/udc empty)"
        return 1
    fi
    g=/sys/kernel/config/usb_gadget/e850
    mkdir -p $g/strings/0x409 $g/configs/c.1/strings/0x409 || return 1
    echo 0x1d6b > $g/idVendor          # Linux Foundation
    echo 0x0104 > $g/idProduct         # Multifunction Composite Gadget
    echo 0xEF > $g/bDeviceClass        # IAD, so hosts bind ACM and ECM separately
    echo 0x02 > $g/bDeviceSubClass
    echo 0x01 > $g/bDeviceProtocol
    cat /sys/devices/soc0/serial_number > $g/strings/0x409/serialnumber 2>/dev/null ||
        echo e850-96 > $g/strings/0x409/serialnumber
    echo "OSDA" > $g/strings/0x409/manufacturer
    echo "E850-96 Linux" > $g/strings/0x409/product
    echo "ACM+ECM" > $g/configs/c.1/strings/0x409/configuration
    for f in acm.usb0 ecm.usb0; do
        mkdir -p $g/functions/$f && ln -s $g/functions/$f $g/configs/c.1/ 2>/dev/null
    done
    echo "$udc" > $g/UDC || { log "cannot bind gadget to $udc"; return 1; }
    log "USB gadget on $udc (ACM $GS, ECM usb0)"
}

# Respawning shell on the ACM port, in the background
gs_shell_loop() {
    while true; do
        # the Mac enumerates the gadget only ~40 s after boot (usb_notify "booting delay")
        until grep -qx configured /sys/class/udc/*/state 2>/dev/null; do sleep 1; done
        [ -c /dev/ttyGS0 ] && setsid -c sh </dev/ttyGS0 >/dev/ttyGS0 2>&1 &
        echo $! > /tmp/gs-shell.pid
        wait $!
        sleep 1
    done
}

log "kernel $KVER, stage 1 modules"
load_list $MODDIR/modules.stage1
# Hardware watchdog: busybox pings it every 5 s. If the whole system hangs, the SoC resets
# after 60 s instead of staying halted (and LK may then stop in fastboot: "Abnormal RST_STAT").
# The hardware limit is unknown (two clusters, cl1 multistage), so ping every second.
case " $(cat /proc/cmdline) " in *" e850.nowdt "*) NOWDT=1 ;; esac
if [ -c /dev/watchdog ] && [ -z "$NOWDT" ]; then
    watchdog -T 30 -t 200ms /dev/watchdog &&
        log "watchdog started: timeout $(cat /sys/class/watchdog/watchdog0/timeout 2>/dev/null) s," \
            "max $(cat /sys/class/watchdog/watchdog0/max_timeout 2>/dev/null) s, ping 200 ms"
fi
# e850.nousb on the kernel command line: skip the USB gadget (debugging resets, docs 7.16)
case " $(cat /proc/cmdline) " in *" e850.nousb "*) NOUSB=1 ;; esac
[ -z "$NOUSB" ] && usb_gadget

# No S2MU106 PDIC on the E850-96, so nothing reports VBUS; e850-vbus.ko does (modules/e850-vbus).
# Until the host has configured the gadget the controller is clock-gated, and opening ttyGS0
# hangs the bus. So ttyGS0 is used only once the UDC state is "configured".
[ -z "$NOUSB" ] && { modprobe e850-vbus 2>/tmp/err || log "e850-vbus: $(cat /tmp/err)"; }
udc_ok=
i=0
[ -n "$NOUSB" ] && i=10
while [ $i -lt 10 ]; do
    st=$(cat /sys/class/udc/*/state 2>/dev/null)
    log "udc state: $st ($i s)"
    [ "$st" = configured ] && { udc_ok=1; break; }
    sleep 1; i=$((i + 1))
done
[ -n "$udc_ok" ] || { log "gadget not configured yet: no rescue prompt; the shell starts on $GS once it is"; GS=/nonexistent; }

rescue=
if [ -c $GS ]; then
    echo "[init] press Enter within 10 s for a rescue shell" > $GS
    read -t 10 rescue < $GS && rescue=1
fi
if [ -n "$rescue" ]; then
    log "rescue shell on $GS (exit to continue booting)"
    ( exec setsid -c sh <$GS >$GS 2>&1 )
fi

LOOP=
[ -z "$NOUSB" ] && { gs_shell_loop & LOOP=$!; }

# Debug switches on the kernel command line (docs 7.16):
#   e850.stage2=N   load only the first N entries of modules.load (bisecting a reset)
#   e850.noswitch   mount the root but stay here, log "alive" every 5 s, then after 60 s
#                   reboot into LK fastboot (so the next test image can be flashed unattended)
STAGE2=; NOSWITCH=
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        e850.stage2=*) STAGE2=${arg#e850.stage2=} ;;
        e850.noswitch) NOSWITCH=1 ;;
    esac
done
if [ -n "$STAGE2" ]; then
    head -n "$STAGE2" $MODDIR/modules.load > /tmp/modules.stage2
    log "stage 2 modules: first $STAGE2, last one $(tail -n 1 /tmp/modules.stage2)"
else
    cp $MODDIR/modules.load /tmp/modules.stage2
    log "stage 2 modules"
fi
load_list /tmp/modules.stage2

# root=/dev/mmcblkXpN or root=PARTLABEL=<GPT name> (does not depend on mmcblk numbering)
root=; label=
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        root=/dev/*) root=${arg#root=} ;;
        root=PARTLABEL=*) label=${arg#root=PARTLABEL=} ;;
    esac
done

if [ -n "$root$label" ]; then
    log "waiting for ${root:-PARTLABEL=$label}"
    i=0
    while [ $i -lt 300 ]; do
        [ -n "$label" ] && root=$(part-dev "$label" 2>/dev/null)
        [ -n "$root" ] && [ -b "$root" ] && break
        sleep 0.1; i=$((i + 1))
    done
    # userdata is mmcblk0p24 on this board (GPT); used if the name lookup failed
    [ -b "$root" ] || { log "no ${root:-PARTLABEL=$label}; trying /dev/mmcblk0p24"; root=/dev/mmcblk0p24; }
    if mount -t ext4 -o rw "$root" /newroot 2>/tmp/err &&
       { [ -L /newroot/sbin/init ] || [ -x /newroot/sbin/init ]; }; then   # Debian: absolute symlink
        if [ -n "$NOSWITCH" ]; then
            log "mounted $root ($(ls /newroot | wc -l) entries); e850.noswitch: staying here"
            i=0
            while [ $i -lt 60 ]; do sleep 5; i=$((i + 5)); log "alive ${i} s"; done
            log "test done: rebooting into LK fastboot"
            sync; rebootarg bootloader
            while true; do sleep 5; done
        fi
        log "switching to $root"
        # the gadget stays bound; the Debian getty takes over $GS
        kill $LOOP $(cat /tmp/gs-shell.pid 2>/dev/null) 2>/dev/null
        umount /sys/kernel/config 2>/dev/null
        mount --move /dev /newroot/dev
        umount /proc /sys /tmp
        exec switch_root /newroot /sbin/init
    fi
    log "cannot use $root: $(cat /tmp/err)"
fi

log "no root filesystem; shell stays on $GS"
while true; do sleep 3600; done
