#!/bin/busybox sh
# First-stage init for the E850-96 vendor 5.10 (GKI) kernel without Android.
#
# Most SoC drivers (timer, pinctrl, clocks, eMMC, UART) are modules, so this
# initramfs plays the role of Android's vendor_boot: load every module in
# modules.load order, then switch to the root filesystem given by root=.
#
# Stage 1 loads only what the eMMC, reboot, the watchdog and the USB device
# port need (modules.stage1). Then a USB gadget (ACM serial + NCM network)
# is set up on the USB-C port; on the Mac the shell is /dev/cu.usbmodem*.
# The debug UART (ttySAC0) carries kernel messages only: opening it from user
# space hung the board (see docs/E85096-LINUX510-BOOT.md 7.15).
#
# After the gadget is up, init waits 10 s on the ACM port: press Enter for a
# rescue shell before the remaining modules are loaded. The shell has
# `restore-android` (writes the stock Android 10 boot image back) and
# `rebootarg bootloader` (next boot stops in LK fastboot).
# If no root is given or it cannot be mounted, a shell runs on the ACM port.
# This script never exits: PID 1 exiting panics the kernel.

/bin/busybox --install -s /bin
mkdir -p /proc /sys /dev /tmp /newroot
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /tmp
if ! mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
    # Kernel without CONFIG_DEVTMPFS: static nodes now, mdev after the modules
    mount -t tmpfs -o mode=0755 tmpfs /dev
    mknod -m 600 /dev/console c 5 1
    mknod -m 666 /dev/null c 1 3
    mknod -m 644 /dev/kmsg c 1 11
    echo /bin/mdev > /proc/sys/kernel/hotplug
    MDEV=1
fi
# Never open /dev/console here: it is the debug UART once exynos_tty is loaded.
exec </dev/null >/dev/null 2>&1

log() { echo "[init] $*" > /dev/kmsg; }

KVER=$(uname -r)
MODDIR=/lib/modules/$KVER
GS=/dev/ttyGS0

load_list() {
    n=0; fail=0
    for m in $(cat "$1"); do
        name=$(basename "$m" .ko)
        if modprobe "$name" 2>/tmp/err; then
            n=$((n + 1))
        else
            fail=$((fail + 1))
            log "modprobe $name failed: $(cat /tmp/err)"
        fi
    done
    [ -n "$MDEV" ] && mdev -s
    log "$1: $n ok, $fail failed"
}

# USB gadget through configfs: acm.usb0 -> /dev/ttyGS0, ncm.usb0 -> network interface usb0
usb_gadget() {
    mkdir -p /sys/kernel/config
    mount -t configfs configfs /sys/kernel/config 2>/dev/null
    i=0
    while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
    udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
    if [ -z "$udc" ]; then
        log "no USB device controller (/sys/class/udc empty)"
        return 1
    fi
    g=/sys/kernel/config/usb_gadget/e850
    mkdir -p $g/strings/0x409 $g/configs/c.1/strings/0x409 || return 1
    echo 0x1d6b > $g/idVendor          # Linux Foundation
    echo 0x0104 > $g/idProduct         # Multifunction Composite Gadget
    echo 0xEF > $g/bDeviceClass        # IAD, so hosts bind ACM and NCM separately
    echo 0x02 > $g/bDeviceSubClass
    echo 0x01 > $g/bDeviceProtocol
    cat /sys/devices/soc0/serial_number > $g/strings/0x409/serialnumber 2>/dev/null ||
        echo e850-96 > $g/strings/0x409/serialnumber
    echo "OSDA" > $g/strings/0x409/manufacturer
    echo "E850-96 Linux" > $g/strings/0x409/product
    echo "ACM+NCM" > $g/configs/c.1/strings/0x409/configuration
    for f in acm.usb0 ncm.usb0; do
        mkdir -p $g/functions/$f && ln -s $g/functions/$f $g/configs/c.1/ 2>/dev/null
    done
    echo "$udc" > $g/UDC || { log "cannot bind gadget to $udc"; return 1; }
    log "USB gadget on $udc (ACM $GS, NCM usb0)"
}

# Respawning shell on the ACM port, in the background
gs_shell_loop() {
    while true; do
        [ -c $GS ] && setsid -c sh <$GS >$GS 2>&1 &
        echo $! > /tmp/gs-shell.pid
        wait $!
        sleep 1
    done
}

log "kernel $KVER, stage 1 modules"
load_list $MODDIR/modules.stage1
# Hardware watchdog: busybox pings it every 5 s. If the whole system hangs, the SoC resets
# after 60 s instead of staying halted (and LK may then stop in fastboot: "Abnormal RST_STAT").
if [ -c /dev/watchdog ]; then
    watchdog -T 60 -t 5 /dev/watchdog && log "watchdog started (60 s)"
fi
usb_gadget

rescue=
if [ -c $GS ]; then
    echo "[init] press Enter within 10 s for a rescue shell" > $GS
    read -t 10 rescue < $GS && rescue=1
fi
if [ -n "$rescue" ]; then
    log "rescue shell on $GS (exit to continue booting)"
    ( exec setsid -c sh <$GS >$GS 2>&1 )
fi

gs_shell_loop &
LOOP=$!

log "stage 2 modules"
load_list $MODDIR/modules.load

# root=/dev/mmcblkXpN or root=PARTLABEL=<GPT name> (does not depend on mmcblk numbering)
root=; label=
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        root=/dev/*) root=${arg#root=} ;;
        root=PARTLABEL=*) label=${arg#root=PARTLABEL=} ;;
    esac
done

if [ -n "$root$label" ]; then
    log "waiting for ${root:-PARTLABEL=$label}"
    i=0
    while [ $i -lt 100 ]; do
        [ -n "$label" ] && root=$(part-dev "$label" 2>/dev/null)
        [ -n "$root" ] && [ -b "$root" ] && break
        sleep 0.1; i=$((i + 1))
    done
    if mount -t ext4 -o rw "$root" /newroot 2>/tmp/err && [ -x /newroot/sbin/init ]; then
        log "switching to $root"
        # the gadget stays bound; the Debian getty takes over $GS
        kill $LOOP $(cat /tmp/gs-shell.pid 2>/dev/null) 2>/dev/null
        umount /sys/kernel/config 2>/dev/null
        mount --move /dev /newroot/dev
        umount /proc /sys /tmp
        exec switch_root /newroot /sbin/init
    fi
    log "cannot use $root: $(cat /tmp/err)"
fi

log "no root filesystem; shell stays on $GS"
while true; do sleep 3600; done
