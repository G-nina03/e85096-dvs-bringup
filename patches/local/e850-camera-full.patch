--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/board/erd/camera/module_s5krc1s.dtsi
@@ -0,0 +1,126 @@
+/*
+ * Samsung S5KRC1S DVS module definition for Exynos Pablo
+ *
+ * Initial bring-up profile:
+ *   - physical sensor: 960 x 720
+ *   - host transport: RAW8 compatibility mode
+ *   - payload: 8192 bytes
+ *   - packet count: 127 (temporary; verify 127/128 on E850)
+ *   - 2 data lanes for E850-96 CN4
+ *
+ * This file describes the generic sensor module. Board wiring, reset and
+ * I2C/CSI routing are in s5e3830-e850-s5krc1s-camera.dtsi.
+ */
+
+#include <dt-bindings/camera/exynos_is_dt.h>
+
+/ {
+	fragment@s5krc1s_module {
+		target-path = "/";
+
+		__overlay__ {
+			is_sensor_s5krc1s: is_sensor_s5krc1s@42 {
+				compatible = "samsung,sensor-module";
+
+				sensor_id = <SENSOR_NAME_S5KRC1S>;
+
+				active_width = <960>;
+				active_height = <720>;
+				margin_left = <0>;
+				margin_right = <0>;
+				margin_top = <0>;
+				margin_bottom = <0>;
+
+				/*
+				 * DVS scan/event timing is not conventional video FPS.
+				 * 30 is only a framework bring-up value.
+				 */
+				max_framerate = <30>;
+				bitwidth = <8>;
+
+				sensor_maker = "SLSI";
+				sensor_name = "S5KRC1S";
+				setfile_name = "setfile_s5krc1s.bin";
+
+				status = "okay";
+
+				vc_extra {
+					stat0 = <>;
+					stat1 = <>;
+					stat2 = <>;
+					stat3 = <>;
+				};
+
+				modes {
+					/*
+					 * common =
+					 * <width height fps settle mode lane speed
+					 *  interleave lrte pd_mode ex_mode>
+					 *
+					 * First bring-up uses CSI-2 RAW8 (DT 0x2A).
+					 * mipi_speed=1600 means 1600 Mbps/lane and MUST
+					 * be changed if the actual S5KRC1S PLL/setfile
+					 * is configured for a different lane rate.
+					 */
+					mode0 {
+						common =
+							<8192 127 30
+							 0 0
+							 CSI_DATA_LANES_2
+							 1600
+							 CSI_MODE_VC_ONLY
+							 LRTE_DISABLE
+							 PD_NONE
+							 EX_NONE>;
+
+						vc0 =
+							<0 HW_FORMAT_RAW8 8192 127
+							 HW_FORMAT_RAW8 VC_NOTHING
+							 8192 127>;
+
+						vc1 =
+							<1 HW_FORMAT_UNKNOWN 0 0
+							 HW_FORMAT_UNKNOWN VC_NOTHING 0 0>;
+
+						vc2 =
+							<2 HW_FORMAT_UNKNOWN 0 0
+							 HW_FORMAT_UNKNOWN VC_NOTHING 0 0>;
+
+						vc3 =
+							<3 HW_FORMAT_UNKNOWN 0 0
+							 HW_FORMAT_UNKNOWN VC_NOTHING 0 0>;
+					};
+					/* 32 packets per MIPI frame: a VC0 buffer every ~16 ms in a sparse scene (11.26) */
+					mode1 {
+						common =
+							<8192 32 30
+							 0 0
+							 CSI_DATA_LANES_2
+							 1600
+							 CSI_MODE_VC_ONLY
+							 LRTE_DISABLE
+							 PD_NONE
+							 EX_NONE>;
+
+						vc0 =
+							<0 HW_FORMAT_RAW8 8192 32
+							 HW_FORMAT_RAW8 VC_NOTHING
+							 8192 32>;
+
+						vc1 =
+							<1 HW_FORMAT_UNKNOWN 0 0
+							 HW_FORMAT_UNKNOWN VC_NOTHING 0 0>;
+
+						vc2 =
+							<2 HW_FORMAT_UNKNOWN 0 0
+							 HW_FORMAT_UNKNOWN VC_NOTHING 0 0>;
+
+						vc3 =
+							<3 HW_FORMAT_UNKNOWN 0 0
+							 HW_FORMAT_UNKNOWN VC_NOTHING 0 0>;
+					};
+				};
+			};
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/exynos/board/erd/camera/s5e3830-e850-ov5647-camera.dtsi b/arch/arm64/boot/dts/exynos/board/erd/camera/s5e3830-e850-ov5647-camera.dtsi
new file mode 100644
index 000000000..87b0c0607
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/board/erd/camera/s5e3830-e850-ov5647-camera.dtsi
@@ -0,0 +1,189 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * E850-96 / S5E3830: OV5647 (Raspberry Pi camera v1 style module) on CN4
+ *
+ *   OV5647 -> CN4 -> hsi2c_2 (I2C4 net, Linux i2c-8 on Android 10) / sensor instance 1 -> CSI1
+ *
+ * Measured on the board (Android 10, docs/E85096-OV5647-CHIPID-RAW-LOG.md):
+ *   CN4 pin 15 CAM_VDD_33 = PMIC LDO32, 3.3 V, already enabled
+ *   CN4 pin 11 CAM_GPIO   = GPG1[5]; on the RPi-style module this is the power enable
+ *   CN4 pin 12 MCLK2      = GPC0[2]; the module has its own oscillator, MCLK is not driven
+ *   chip ID 0x5647 read at 7-bit address 0x36 with only CAM_GPIO high
+ */
+
+#include "module_ov5647.dtsi"
+
+&is_sensor_ov5647 {
+	pinctrl-names = "pin0", "pin1", "pin2", "release";
+	pinctrl-0 = <>;
+	pinctrl-1 = <>;
+	pinctrl-2 = <>;
+	pinctrl-3 = <>;
+
+	position = <1>;
+	id = <1>;
+	mclk_ch = <2>;
+	sensor_i2c_ch = <2>;
+
+	status = "okay";
+
+	power_seq {
+		/* use = <1>: take the power sequence from here. Without it the framework calls the
+		 * sensor module's dt callback, which a CIS-only driver does not have: NULL ->
+		 * "sensor dt callback is NULL", then an oops in sensor_module_probe (docs 7.18). */
+		use = <1>;
+		gpio_mclk = <&gpc0 2 0x1>;
+
+		scenario_normal_on {
+			sensor_scenario = <SENSOR_SCENARIO_NORMAL>;
+			gpio_scenario = <GPIO_SCENARIO_ON>;
+
+			/* CAM_VDD_33 (CN4 pin 15). Android 10 left it on; on Linux nothing else uses
+			 * LDO32, so it is off until the sensor powers up (chip ID read gave -ENXIO). */
+			10 {
+				pname = "vdd_ldo32";
+				pin = <PIN_REGULATOR 1 2000>;
+			};
+
+			20 {
+				pname = "cam_gpio low";
+				pin = <PIN_OUTPUT 0 10000>;
+				gpio = <&gpg1 5 0x1>;
+			};
+
+			30 {
+				pname = "cam_gpio high (module power enable)";
+				pin = <PIN_OUTPUT 1 20000>;
+				gpio = <&gpg1 5 0x1>;
+			};
+
+			40 {
+				pname = "on_i2c";
+				pin = <PIN_I2C 1 0>;
+			};
+		};
+
+		scenario_normal_off {
+			sensor_scenario = <SENSOR_SCENARIO_NORMAL>;
+			gpio_scenario = <GPIO_SCENARIO_OFF>;
+
+			10 {
+				pname = "off_i2c";
+				pin = <PIN_I2C 0 0>;
+			};
+
+			20 {
+				pname = "cam_gpio low";
+				pin = <PIN_OUTPUT 0 1000>;
+				gpio = <&gpg1 5 0x1>;
+			};
+
+			30 {
+				pname = "vdd_ldo32";
+				pin = <PIN_REGULATOR 0 0>;
+			};
+		};
+
+		/* Same sequence for SENSOR_SCENARIO_VISION: S_INPUT with scenario 1 puts the sensor in
+		 * "stand alone" mode (sensor driving without the 3AA/ISP chain), used for RAW capture. */
+		scenario_vision_on {
+			sensor_scenario = <SENSOR_SCENARIO_VISION>;
+			gpio_scenario = <GPIO_SCENARIO_ON>;
+
+			/* CAM_VDD_33 (CN4 pin 15). Android 10 left it on; on Linux nothing else uses
+			 * LDO32, so it is off until the sensor powers up (chip ID read gave -ENXIO). */
+			10 {
+				pname = "vdd_ldo32";
+				pin = <PIN_REGULATOR 1 2000>;
+			};
+
+			20 {
+				pname = "cam_gpio low";
+				pin = <PIN_OUTPUT 0 10000>;
+				gpio = <&gpg1 5 0x1>;
+			};
+
+			30 {
+				pname = "cam_gpio high (module power enable)";
+				pin = <PIN_OUTPUT 1 20000>;
+				gpio = <&gpg1 5 0x1>;
+			};
+
+			40 {
+				pname = "on_i2c";
+				pin = <PIN_I2C 1 0>;
+			};
+		};
+
+		scenario_vision_off {
+			sensor_scenario = <SENSOR_SCENARIO_VISION>;
+			gpio_scenario = <GPIO_SCENARIO_OFF>;
+
+			10 {
+				pname = "off_i2c";
+				pin = <PIN_I2C 0 0>;
+			};
+
+			20 {
+				pname = "cam_gpio low";
+				pin = <PIN_OUTPUT 0 1000>;
+				gpio = <&gpg1 5 0x1>;
+			};
+
+			30 {
+				pname = "vdd_ldo32";
+				pin = <PIN_REGULATOR 0 0>;
+			};
+		};
+	};
+};
+
+/* CAM_VDD_33 is 3.3 V (Android 10 DT: LDO32 3300000 uV); the ERD PMIC dtsi fixes it at 2.8 V */
+&l32_reg {
+	regulator-min-microvolt = <3300000>;
+	regulator-max-microvolt = <3300000>;
+};
+
+&hsi2c_2 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	gpios = <&gpc1 4 0 &gpc1 5 0>;
+	status = "okay";
+	clock-frequency = <400000>;
+
+	samsung,reset-before-trans;
+
+	ov5647@36 {
+		compatible = "samsung,exynos-is-cis-ov5647";
+		reg = <0x36>;
+		id = <1>;
+		setfile = "setA";
+	};
+};
+
+&is_sensor1 {
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	scenario = <SENSOR_SCENARIO_NORMAL>;
+	id = <1>;
+	csi_ch = <1>;
+
+	dma_ch = <1 1 1 1>;
+	vc_ch = <0 1 2 3>;
+
+	flite_ch = <FLITE_ID_NOTHING>;
+	is_bns = <0>;
+	csi_mux = <0x1>;
+
+	status = "okay";
+};
+
+/* S_INPUT(position 1 = FRONT) looks the sensor up by vender front_sensor_id. The ERD camera
+ * dtsi this file replaces used to set it (4H5YC); without the node it stays 0. */
+&exynos_is {
+	vender {
+		front_sensor_id = <SENSOR_NAME_OV5647>;	/* 219 */
+	};
+};
diff --git a/arch/arm64/boot/dts/exynos/board/erd/camera/s5e3830-e850-s5krc1s-camera.dtsi b/arch/arm64/boot/dts/exynos/board/erd/camera/s5e3830-e850-s5krc1s-camera.dtsi
