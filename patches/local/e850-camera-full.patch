+++ b/drivers/media/platform/exynos/camera/sensor/module_framework/cis/is-cis-ov5647-setA.h
@@ -0,0 +1,408 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * OV5647 register tables for the Exynos Pablo CIS framework.
+ * Generated by modules/ov5647-pablo/gen_setfile.py from mainline Linux v6.6
+ * drivers/media/i2c/ov5647.c. Do not edit by hand.
+ * Tuple format: register, value, byte count (or I2C_MODE_DELAY, microseconds, 0).
+ */
+#ifndef IS_CIS_OV5647_SET_A_H
+#define IS_CIS_OV5647_SET_A_H
+
+#include "is-cis.h"
+#include "is-cis-ov5647.h"
+
+/* Output pads on (mainline sensor_oe_enable_regs), then stream-off state so the
+ * MIPI lanes sit in LP-11 before the CSIS receiver is started. */
+static const u32 sensor_ov5647_setfile_A_Global[] = {
+	0x3000, 0x0f, 0x1,
+	0x3001, 0xff, 0x1,
+	0x3002, 0xe4, 0x1,
+	OV5647_REG_MIPI_CTRL00, OV5647_MIPI_CTRL00_STREAM_OFF, 0x1,
+	OV5647_REG_FRAME_OFF_NUMBER, 0x0f, 0x1,
+	OV5647_REG_PAD_OUT, 0x01, 0x1,
+};
+
+/* 640x480: VGA, 2x2 binned + subsampled, RAW10, 60 fps (87 registers) */
+static const u32 sensor_ov5647_setfile_A_640x480[] = {
+	0x0100, 0x00, 0x1,
+	0x0103, 0x01, 0x1,
+	I2C_MODE_DELAY, 5000, 0x0,
+	0x3035, 0x11, 0x1,
+	0x3036, 0x46, 0x1,
+	0x303c, 0x11, 0x1,
+	0x3821, 0x07, 0x1,
+	0x3820, 0x41, 0x1,
+	0x370c, 0x03, 0x1,
+	0x3612, 0x59, 0x1,
+	0x3618, 0x00, 0x1,
+	0x5000, 0x06, 0x1,
+	0x5003, 0x08, 0x1,
+	0x5a00, 0x08, 0x1,
+	0x3000, 0xff, 0x1,
