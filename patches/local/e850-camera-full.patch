+/*
+ * Samsung S5KRC1S DVS CIS definitions
+ */
+#ifndef IS_CIS_S5KRC1S_H
+#define IS_CIS_S5KRC1S_H
+
+#include "is-cis.h"
+
+#define S5KRC1S_EXT_CLK_MHZ		24
+
+#define SENSOR_S5KRC1S_MAX_WIDTH	960
+#define SENSOR_S5KRC1S_MAX_HEIGHT	720
+
+#define S5KRC1S_REG_SEL_MODE		0x3000
+#define S5KRC1S_MODE_STANDBY		0x00
+#define S5KRC1S_MODE_MONITOR		0x01
+#define S5KRC1S_MODE_STREAM		0x02
+
+#define S5KRC1S_REG_CCI_ADDRESS		0x3024
+
+#define S5KRC1S_REG_OUTIF_ENABLE	0x30A0
+#define S5KRC1S_REG_DPHY_ENABLE0	0x30A2
+#define S5KRC1S_REG_DPHY_ENABLE1	0x30A3
+
+#define S5KRC1S_REG_CSI2_DI		0x3901
+#define S5KRC1S_REG_CSI2_WC_LOW		0x3902
+#define S5KRC1S_REG_CSI2_WC_HIGH	0x3903
+#define S5KRC1S_REG_CSI2_EMBD_DI	0x3906
+#define S5KRC1S_REG_MIPI_TIMEOUT	0x3910
+#define S5KRC1S_REG_MIPI_MODE		0x3915
+#define S5KRC1S_REG_PACKET_NUM_LOW	0x391A
+#define S5KRC1S_REG_PACKET_NUM_HIGH	0x391B
+#define S5KRC1S_REG_GROUP_EVENT		0x392C
+
+#define S5KRC1S_CSI2_DT_RAW8		0x2A
+#define S5KRC1S_CSI2_DT_NATIVE		0x31
+
+#define S5KRC1S_WORD_COUNT		0x2000
+#define S5KRC1S_BRINGUP_PACKET_COUNT	127
+
+#endif
